{
  "name": "@neuron/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scheduling algorithm. Pure TypeScript, no runtime dependencies",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx demo/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p demo/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-fsrs": "^5.4.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  }
}
