{
  "name": "neuron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spaced repetition that schedules your time, not your card count",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "node scripts/check-core-isolation.mjs && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest --project core",
    "db:generate": "pnpm --filter @neuron/api db:generate",
    "db:migrate": "pnpm --filter @neuron/api db:migrate",
    "db:seed": "pnpm --filter @neuron/api db:seed",
    "db:role": "pnpm --filter @neuron/api db:role",
    "db:test-db": "pnpm --filter @neuron/api db:test-db",
    "db:bench": "pnpm --filter @neuron/api db:bench",
    "db:erase": "pnpm --filter @neuron/api db:erase",
    "db:studio": "pnpm --filter @neuron/api db:studio"
  },
  "devDependencies": {
    "@neuron/config": "workspace:*",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
