# Postgres connection string for the api
DATABASE_URL=

# Secret that signs session cookies, at least 32 random bytes
BETTER_AUTH_SECRET=

# Base url the auth endpoints are served from
BETTER_AUTH_URL=

# OAuth client id from the Google Cloud console
GOOGLE_CLIENT_ID=

# OAuth client secret from the Google Cloud console
GOOGLE_CLIENT_SECRET=

# Origin the web app is served from, used for cookies and CORS
APP_ORIGIN=
