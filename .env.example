# Postgres connection for the api, using the restricted neuron_app role.
# This role can read and write rows but cannot change the shape of the database
# and cannot bypass the isolation policies. On the user table it may read ten
# columns and write seven, on its own row only, and it cannot reach the session,
# account or verification tables at all.
# Written by pnpm db:role.
DATABASE_URL=

# Postgres connection for the neuron_auth role, which Better Auth uses and
# nothing else does. It reaches the four auth tables in full and none of the
# collection. Two roles rather than one is what makes "this statement is part of
# signing in" something the database can check.
# Written by pnpm db:role.
DATABASE_URL_AUTH=

# Postgres connection for the database owner, used by migrations, the seed, the
# benchmark and the account erasure task. Never set this on the server: the
# owner can drop tables and Neon grants it BYPASSRLS, so it is not subject to
# row level security.
DATABASE_URL_OWNER=

# Postgres connection for a throwaway database the tests truncate on every run.
# Point it at a Neon branch, never at the branch holding real data.
DATABASE_URL_TEST=

# Secret that signs session cookies and encrypts the two factor secrets and the
# codes for a lost phone. At least 32 random bytes, and it has to stay the same:
# changing it makes every existing second factor unreadable.
BETTER_AUTH_SECRET=

# Base url the auth endpoints are served from
BETTER_AUTH_URL=

# Whether anybody new may register. Defaults to true.
# Set it to false once the people who need accounts have them. Existing accounts
# are unaffected, and it takes effect on the next deploy without a code change.
# Temporary: email verification is the real answer, and it is switched off.
AUTH_REGISTRATION_OPEN=true

# How many accounts one address may successfully create in a day. Defaults to 3.
# Successes, not attempts. The rate limiter already counts attempts, and an
# attempt limit does nothing about somebody registering patiently. Also
# temporary, for the same reason.
AUTH_MAX_REGISTRATIONS_PER_DAY=3

# Whether an account has to confirm its address before it can be used.
# False, because there is no mail sender yet. The whole path behind this flag is
# written and covered by tests that run with it on, so switching it on costs a
# domain, a provider and this line.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Which mailer to build. `log` writes the message to the server log and sends
# nothing, which is what makes the verification flow testable today. Adding a
# real provider means a second implementation and a new value here.
MAILER=log

# Origin the web app is served from, used for cookies and CORS
APP_ORIGIN=
