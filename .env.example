# Postgres connection for the api, using the restricted neuron_app role.
# This role can read and write rows but cannot change the shape of the database
# and cannot bypass the isolation policies. It is the only database credential
# the deployed api ever receives.
DATABASE_URL=

# Postgres connection for the database owner, used by migrations, the seed and
# the benchmark. Never set this on the server: the owner can drop tables and
# Neon grants it BYPASSRLS, so it is not subject to row level security.
DATABASE_URL_OWNER=

# Postgres connection for a throwaway database the tests truncate on every run.
# Point it at a Neon branch, never at the branch holding real data.
DATABASE_URL_TEST=

# Secret that signs session cookies, at least 32 random bytes
BETTER_AUTH_SECRET=

# Base url the auth endpoints are served from
BETTER_AUTH_URL=

# OAuth client id from the Google Cloud console
GOOGLE_CLIENT_ID=

# OAuth client secret from the Google Cloud console
GOOGLE_CLIENT_SECRET=

# Origin the web app is served from, used for cookies and CORS
APP_ORIGIN=
